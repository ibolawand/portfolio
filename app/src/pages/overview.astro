---
// src/pages/overview.astro — projects / landing page
import "../styles/global.css";
import "../styles/home.css";

interface Project {
  title: string;
  blurb: string;
  tags: string[];
  status: "live" | "building" | "planned";
  link?: string;
  github?: string;
  image?: string;
}

const name = "Lawand Ibo";
const role = "Software Developer";
const intro =
  "I build things that talk to each other — web apps, backends, and small AI tools that run on my own hardware.";
const email = "ibolawand432@gmail.com";
const github = "https://github.com/ibolawand";

const projects: Project[] = [
  {
    title: "MyNotes",
    blurb: "A quest-based productivity tracker with an AI assistant, a calendar and an XP system.",
    tags: ["Angular", "TypeScript", "Node.js", "SQLite","Electron"],
    status: "building",
  },
  {
    title: "Aria, my voice assistant",
    blurb: "A local AI assistant with speech recognition, text-to-speech, app control and system integration.",
    tags: ["Python", "Ollama", "Whisper", "PyAudio"],
    status: "building",
  },
  {
    title: "This website",
    blurb: "Self-hosted at home in Docker and served through a Cloudflare Tunnel.",
    tags: ["Astro", "TypeScript", "Docker", "Cloudflare"],
    status: "live",
  },
];

const statusLabel = { live: "Live", building: "In progress", planned: "Planned" } as const;

const skills = [
  { label: "Frontend", items: ["Angular", "TypeScript", "HTML", "CSS"] },
  { label: "Backend", items: ["Node.js", "Express", "Java", "C#"] },
  { label: "Databases", items: ["SQLite", "PostgreSQL", "MySQL"] },
  { label: "Tools", items: ["Docker", "Git", "Linux", "VS Code"] },
  { label: "Also", items: ["C++","Arduino", "3D printing"] },
];

const description = `${name}: ${role}. ${intro}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3222a" />
    <meta property="og:title" content={`${name} — ${role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{name} — {role}</title>
  </head>
  <body>
    <a href="#projects" class="skip-link">Skip to projects</a>

    <!-- ============ TOP BAR ============ -->
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="#top">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{name}</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="#projects"><span class="nav-num">01</span>Work</a>
          <a href="#stack"><span class="nav-num">02</span>Stack</a>
          <a href="#contact"><span class="nav-num">03</span>Contact</a>
        </nav>
        <a href="/" class="nav-ask">Ask Aria ↗</a>
      </div>
    </header>

    <main id="top">

      <!-- ============ HERO ============ -->
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-kicker">
            <span>PORTFOLIO</span>
            <span class="hero-rule"></span>
            <span>SELECTED WORK · {year}</span>
          </div>

          <h1 class="hero-title">
            <span class="hero-line"><span class="hero-word">Software</span></span>
            <span class="hero-line"><span class="hero-word hero-em"><em>Developer</em></span></span>
            <span class="hero-line"><span class="hero-word">based in Austria.</span></span>
          </h1>

          <div class="hero-foot">
            <p class="hero-lede">{intro}</p>
            <div class="hero-cta">
              <a class="btn-solid" href="#projects">
                See the work <span aria-hidden="true">→</span>
              </a>
              <a class="btn-outline" href={`mailto:${email}`}>
                Get in touch
              </a>
            </div>
          </div>

          <ul class="hero-index" aria-hidden="true">
            <li><span>001</span><span>Angular</span></li>
            <li><span>002</span><span>Node.js</span></li>
            <li><span>003</span><span>Docker</span></li>
            <li><span>004</span><span>AI / LLMs</span></li>
          </ul>
        </div>
      </section>

      <!-- ============ PROJECTS (ink band) ============ -->
      <section class="band band-ink" id="projects">
        <div class="band-inner">
          <header class="band-head">
            <div>
              <span class="kicker kicker-inv">01 — Selected work</span>
              <h2 class="band-title">
                Things I'm <em class="italic">building</em>.
              </h2>
            </div>
            <p class="band-note">
              {projects.length} projects · ongoing<br />
              Updated whenever I ship.
            </p>
          </header>

          <ol class="work-list" id="work-list">
            {projects.map((p, i) => (
              <li class="work-item" data-index={i}>
                <a
                  class="work-link"
                  href={p.link ?? p.github ?? "#"}
                  target={p.link || p.github ? "_blank" : undefined}
                  rel="noopener noreferrer"
                >
                  <span class="work-num">{String(i + 1).padStart(3, "0")}</span>
                  <span class="work-main">
                    <span class="work-title">{p.title}</span>
                    <span class="work-blurb">{p.blurb}</span>
                  </span>
                  <span class="work-tags">
                    {p.tags.slice(0, 3).map((t) => <span>{t}</span>)}
                  </span>
                  <span class={`work-status ${p.status}`}>
                    <span class="dot" aria-hidden="true"></span>
                    {statusLabel[p.status]}
                  </span>
                  <span class="work-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <div class="band-cta">
            <p>
              Rather ask than read? <em class="italic">Aria</em> is a small AI running on my own
              machine — she knows what's on this page.
            </p>
            <a class="btn-solid btn-solid--cream" href="/">
              Ask Aria <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <!-- Hover preview follows cursor -->
        <div class="work-peek" id="work-peek" aria-hidden="true">
          {projects.map((p, i) => (
            <div class="peek-slide" data-index={i}>
              {p.image ? (
                <img src={p.image} alt="" />
              ) : (
                <div class="peek-placeholder">
                  <span>{String(i + 1).padStart(3, "0")}</span>
                  <span>{p.title}</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- ============ ABOUT + STACK (red band, deep) ============ -->
      <section class="band band-deep" id="stack">
        <div class="band-inner">
          <header class="band-head">
            <div>
              <span class="kicker">02 — Background & tools</span>
              <h2 class="band-title">
                About the <em class="italic">work</em>.
              </h2>
            </div>
          </header>

          <div class="spread">
            <article class="prose">
              <p class="drop">
                I'm a software engineering student in Austria. I like finding out how things
                work — a backend, a physics problem, or a small robot.
              </p>
              <p>
                Outside of code: piano, physics, anime, and I'm slowly learning Chinese.
              </p>
              <p class="signature">— Lawand</p>
            </article>

            <aside class="stack-panel">
              <span class="kicker">Tools I reach for</span>
              <dl class="stack">
                {skills.map((g) => (
                  <div class="stack-row">
                    <dt>{g.label}</dt>
                    <dd>{g.items.join(" · ")}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          </div>

          <div class="now-strip">
            <span class="kicker">Right now</span>
            <ul>
              <li>building Aria</li>
              <li>learning Chinese</li>
              <li>fixing this site (again)</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ============ CONTACT (ink band) ============ -->
      <section class="band band-ink" id="contact">
        <div class="band-inner">
          <span class="kicker kicker-inv">03 — Contact</span>
          <h2 class="contact-title">
            Let's build<br />
            <em>something.</em>
          </h2>

          <div class="contact-grid">
            <a class="contact-mail" href={`mailto:${email}`}>
              <span>{email}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="contact-gh" href={github} target="_blank" rel="noopener noreferrer">
              <span>github.com/ibolawand</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© {year} {name}</span>
        <span>Built with Astro · hosted at home</span>
        <span>Instrument Serif · Inter · JetBrains Mono</span>
      </div>
    </footer>

    <script>
      const list = document.getElementById("work-list");
      const peek = document.getElementById("work-peek");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isTouch = matchMedia("(hover: none)").matches;

      if (list && peek && !reduce && !isTouch) {
        const slides = peek.querySelectorAll<HTMLElement>(".peek-slide");
        let x = 0, y = 0, tx = 0, ty = 0, current = -1;

        list.addEventListener("pointermove", (e) => {
          const r = list.getBoundingClientRect();
          tx = e.clientX - r.left + 32;
          ty = e.clientY - r.top - 120;
        });
        list.addEventListener("pointerenter", () => peek.classList.add("on"));
        list.addEventListener("pointerleave", () => {
          peek.classList.remove("on");
          current = -1;
          slides.forEach((s) => s.classList.remove("on"));
        });
        list.querySelectorAll<HTMLElement>(".work-item").forEach((item) => {
          item.addEventListener("pointerenter", () => {
            const i = Number(item.dataset.index ?? 0);
            if (i === current) return;
            current = i;
            slides.forEach((s, k) => s.classList.toggle("on", k === i));
          });
        });

        const tick = () => {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          peek.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document
        .querySelectorAll<HTMLElement>(".work-item, .prose p, .stack-row")
        .forEach((el) => {
          el.classList.add("reveal");
          io.observe(el);
        });
    </script>
  </body>
</html>