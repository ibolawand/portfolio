---
// src/pages/index.astro — the AI chat (home)
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/ask.css";

const developerName = "Lawand Ibo";
const email = "ibolawand432@gmail.com";
const suggestions = [
  "What does Lawand build?",
  "Which technologies does he use?",
  "Tell me about the home lab",
  "How can I contact him?",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`Ask an AI about ${developerName}: his work, stack and projects. It runs on a local model at home.`}
    />
    <meta name="theme-color" content="#b3222a" />
    <meta property="og:title" content={`Ask my AI — ${developerName}`} />
    <meta
      property="og:description"
      content={`Ask an AI about ${developerName}: his work, stack and projects. It runs on a local model at home.`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lala-home.uk/" />
    <meta property="og:image" content="https://lala-home.uk/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="https://lala-home.uk/og.png" />
    <link rel="canonical" href="https://lala-home.uk/" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Ask my AI — {developerName}</title>
  </head>
  <body>
    <a href="#chat" class="skip-link">Skip to chat</a>

    <!-- ============ TOP BAR ============ -->
  <div class="page-shell">
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/overview" aria-label="Lawand Ibo — overview">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{developerName}</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/overview"><span class="nav-num">00</span>Overview</a>
        </nav>
        <span class="ai-status" id="ai-status" data-state="checking" role="status">Checking AI…</span>
      </div>
    </header>

    <main class="ask-main">
      <div class="ask-grid">

        <!-- LEFT: Intro -->
        <section class="intro-col" aria-label="About this chat">
          <div class="ask-kicker">
            <span>04 — ASK MY AI</span>
            <span class="ask-rule"></span>
            <span>LOCAL</span>
          </div>

          <h1 class="ask-title">Ask <em>my AI</em>.</h1>

          <p class="ask-lede">
            A small language model, running on my own machine. Ask about my work, my stack or my
            projects — it answers from the facts on this site and can still be wrong, so{" "}
            <a href={`mailto:${email}`}>email me</a> for anything important.
          </p>

          <div class="suggest">
            <span class="kicker">Try asking</span>
            <ul class="chips">
              {suggestions.map((q) => (
                <li><button type="button" class="chip" data-q={q}>{q}</button></li>
              ))}
            </ul>
          </div>
        </section>

        <!-- RIGHT: Avatar + Chat -->
        <section class="chat-col" id="chat" aria-label="Chat with Aria">

          <div class="avatar-row">
            <div id="avatar-container" class="avatar-frame" data-state="idle">
              <div id="avatar-loading" class="avatar-loading">Initializing…</div>
              <span class="avatar-hint" id="avatar-hint" aria-hidden="true">Click me</span>
            </div>

          </div>

          <div class="chat-stack">
            <div class="chat-head">
              <span class="kicker kicker-inv">Conversation</span>
              <span class="chat-line" aria-hidden="true"></span>
              <button type="button" class="clear-btn" id="clear">Clear</button>
            </div>

            <div class="log" id="log" role="log" aria-live="polite" tabindex="0">
              <p class="msg bot">
                Hi! I'm a small AI running on Lawand's own machine. Ask me about his work, his
                stack or his projects.
              </p>
            </div>

            <form class="composer" id="form" autocomplete="off">
              <label class="sr-only" for="input">Your question</label>
              <textarea id="input" rows="1" maxlength="500" placeholder="Ask about Lawand…"></textarea>
              <button type="submit" id="send" class="btn-send" disabled>Send <span aria-hidden="true">→</span></button>
              <button type="button" id="stop" class="btn-stop" hidden>Stop</button>
            </form>

            <p class="fine">
              Answers are generated locally and may be wrong.{" "}
              <a href={`mailto:${email}`}>Email Lawand</a> for important things.
            </p>
          </div>
        </section>

      </div>
    </main>

  </div>

    <script>
      import type { ActionType, AvatarState } from "../scripts/avatar";

      // Avatar state is shared with the chat code below. Until the avatar
      // loads, reactions are simply dropped.
      const S: AvatarState = {
        typing: false, thinking: false, talking: false,
        hover: false, lastChunkAt: 0,
      };
      let react: (type?: ActionType) => void = () => {};

      const avatarEl = document.getElementById("avatar-container");
      if (avatarEl) {
        const io = new IntersectionObserver(
          async (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            const { initAvatar } = await import("../scripts/avatar");
            react = initAvatar(avatarEl, S);
          },
          { rootMargin: "200px" },
        );
        io.observe(avatarEl);
      }

      // ============================================================
      // CHAT LOGIC
      // ============================================================
      type Msg = { role: "user" | "assistant"; content: string };

      const $ = (id: string) => document.getElementById(id)!;
      const log = $("log");
      const form = $("form") as HTMLFormElement;
      const input = $("input") as HTMLTextAreaElement;
      const send = $("send") as HTMLButtonElement;
      const stop = $("stop") as HTMLButtonElement;
      const greeting = log.innerHTML;

      let history: Msg[] = [];
      let controller: AbortController | null = null;
      let online = false;
      let busy = false;
      let typingTimer: number | undefined;

      function addMsg(kind: "user" | "bot" | "error", text = "") {
        const p = document.createElement("p");
        p.className = `msg ${kind}`;
        p.textContent = text;
        log.append(p);
        log.scrollTop = log.scrollHeight;
        return p;
      }

      function refresh() {
        send.disabled = !online || busy;
        send.hidden = busy;
        stop.hidden = !busy;
        input.placeholder = online ? "Ask about Lawand…"
                                   : "The AI is offline right now.";
      }

      function setOnline(on: boolean, model?: string) {
        online = on;

        const statusEl = document.getElementById("ai-status");
        const modelEl = document.getElementById("model-name");

        if (statusEl) {
          statusEl.dataset.state = on ? "online" : "offline";
          statusEl.textContent = on ? "AI online" : "AI offline";
        }

        if (modelEl) {
          modelEl.textContent = on && model ? model : "–";
        }

        // Always reaches refresh() now!
        refresh();
      }
      async function checkHealth() {
        try {
          const r = await fetch("/api/health", {
            cache: "no-store",
            signal: AbortSignal.timeout(3000),
          });
          const d = await r.json();
          setOnline(Boolean(d.online), d.model);
        } catch { setOnline(false); }
      }

      async function ask(text: string) {
        if (busy || !online) return;
        busy = true; refresh();
        addMsg("user", text);
        history.push({ role: "user", content: text });
        const bot = addMsg("bot");
        bot.classList.add("thinking");
        clearTimeout(typingTimer);
        S.typing = false;
        S.thinking = true;
        controller = new AbortController();
        let answer = "";
        let failed = false;
        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ messages: history }),
            signal: controller.signal,
          });
          if (!res.ok || !res.body) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error ?? "Something went wrong. Please try again.");
          }
          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          for (;;) {
            const { value, done } = await reader.read();
            if (done) break;
            if (S.thinking) { S.thinking = false; S.talking = true; }
            S.lastChunkAt = performance.now();
            answer += decoder.decode(value, { stream: true });
            bot.textContent = answer;
            bot.classList.remove("thinking");
            bot.classList.add("streaming");
            log.scrollTop = log.scrollHeight;
          }
          answer += decoder.decode();
          bot.textContent = answer;
          if (!answer.trim()) throw new Error("The model returned nothing. Please try again.");
          history.push({ role: "assistant", content: answer });
        } catch (err) {
          if ((err as DOMException).name === "AbortError") {
            if (answer.trim()) history.push({ role: "assistant", content: answer });
            else { bot.remove(); history.pop(); }
          } else {
            failed = true;
            bot.remove(); history.pop();
            addMsg("error", (err as Error).message);
            checkHealth();
          }
        } finally {
          S.thinking = false; S.talking = false;
          bot.classList.remove("thinking", "streaming");
          controller = null; busy = false; refresh(); input.focus();
          if (failed) react("shrug");
          else if (answer.trim()) react("nod");
        }
      }

      function autosize() {
        input.style.height = "auto";
        input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        input.value = ""; autosize(); ask(text);
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          form.requestSubmit();
        }
      });

      input.addEventListener("input", () => {
        autosize();
        S.typing = input.value.length > 0 && !busy;
        clearTimeout(typingTimer);
        typingTimer = window.setTimeout(() => (S.typing = false), 1800);
      });

      input.addEventListener("blur", () => { S.typing = false; });
      stop.addEventListener("click", () => controller?.abort());

      document.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) =>
        chip.addEventListener("click", () => ask(chip.dataset.q ?? "")),
      );

      $("clear").addEventListener("click", () => {
        controller?.abort();
        history = [];
        log.innerHTML = greeting;
        input.focus();
        react("wave");
      });

      checkHealth();
      setInterval(() => !busy && checkHealth(), 45_000);
    </script>
  </body>
</html>